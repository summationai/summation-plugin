{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grade-artifact/public-receipt-v1",
  "title": "GradeArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "generated_at",
    "source",
    "source_result",
    "verdict",
    "score",
    "findings",
    "evidence_checks",
    "evidence_findings",
    "evidence_coverage",
    "decision",
    "actions",
    "decision_limits",
    "diagnostics",
    "checks",
    "verification",
    "limitations",
    "offer",
    "claims",
    "sources"
  ],
  "properties": {
    "schema_version": { "const": "grade-artifact/public-receipt-v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format"],
      "properties": {
        "path": { "type": "string" },
        "format": { "type": "string" },
        "sha256": { "type": ["string", "null"] },
        "period_label": { "type": ["string", "null"] },
        "report_date": { "type": ["string", "null"] }
      }
    },
    "source_result": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["status", "error", "provider", "profile", "source_identity", "suggested_source", "generated_at", "tables", "confirmed", "contradicted", "not_run", "checks"],
      "properties": {
        "status": { "type": "string", "enum": ["complete", "partial", "failed", "not_applicable"] },
        "error": { "type": ["string", "null"] },
        "provider": { "type": "string", "enum": ["sum-api", "mcp"] },
        "profile": { "type": "string" },
        "source_identity": { "type": ["object", "null"] },
        "suggested_source": { "type": ["string", "null"] },
        "generated_at": { "type": ["string", "null"] },
        "tables": { "type": "array", "items": { "type": "string" } },
        "confirmed": { "type": "integer", "minimum": 0 },
        "contradicted": { "type": "integer", "minimum": 0 },
        "not_run": { "type": "integer", "minimum": 0 },
        "checks": { "type": "array", "items": { "type": "object" } }
      }
    },
    "verdict": {
      "type": "string",
      "enum": ["safe_to_share", "share_with_caveats", "fix_first", "unable_to_grade"]
    },

    "score": {
      "description": "No letter grade. null, or engine-measured rates only.",
      "type": ["object", "null"],
      "properties": {
        "kind": { "const": "tier_d_per_100_claims" },
        "value": { "type": "number" }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "family", "tier", "statement", "location", "claim_ids"],
        "properties": {
          "check_id": { "type": "string" },
          "family": { "type": "string" },
          "tier": { "type": "string" },
          "severity": { "type": ["string", "null"] },
          "statement": { "type": "string" },
          "location": { "type": ["string", "null"] },
          "claim_ids": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": ["object", "null"] },
          "arithmetic": { "type": ["object", "null"] }
        }
      }
    },
    "evidence_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "basis", "verdict", "importance", "severity", "claim_id", "public_receipt"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$" },
          "type": { "type": "string" },
          "basis": { "type": "string", "enum": ["evidence", "report"] },
          "verdict": { "const": "contradicted" },
          "importance": { "type": "string", "enum": ["material", "supporting"] },
          "severity": { "type": ["string", "null"], "enum": ["high", "medium", "low", null] },
          "claim_id": { "type": "string", "minLength": 1 },
          "public_receipt": { "$ref": "#/$defs/publicReceipt" }
        }
      }
    },
    "evidence_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "basis", "verdict", "importance", "severity", "claim_id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$" },
          "type": { "type": "string" },
          "basis": { "type": "string", "enum": ["evidence", "report"] },
          "verdict": { "type": "string", "enum": ["confirmed", "contradicted", "not_checkable", "changed_since_report"] },
          "importance": { "type": "string", "enum": ["material", "supporting"] },
          "severity": { "type": ["string", "null"], "enum": ["high", "medium", "low", null] },
          "report_quote": { "type": "string" },
          "explanation": { "type": "string" },
          "claim_id": { "type": "string", "minLength": 1 },
          "public_receipt": { "$ref": "#/$defs/publicReceipt" },
          "reconstruction_attempt": { "type": ["string", "null"] },
          "report_value": true,
          "current_value": true,
          "current_as_of": { "type": ["string", "null"] },
          "report_date": { "type": ["string", "null"] },
          "location": { "type": ["string", "null"] }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "verdict": {
                  "enum": ["confirmed", "contradicted", "changed_since_report"]
                }
              },
              "required": ["verdict"]
            },
            "then": { "required": ["public_receipt"] }
          },
          {
            "if": {
              "properties": { "verdict": { "const": "not_checkable" } },
              "required": ["verdict"]
            },
            "then": { "required": ["report_quote", "explanation"] }
          }
        ]
      }
    },
    "evidence_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_claims_total", "document_claims_reached", "claim_outcomes_proposed", "material_claims_reviewed", "supporting_claims_reviewed", "confirmed", "contradicted", "not_checkable", "evidence_confirmed", "evidence_contradicted", "evidence_not_checkable", "report_confirmed", "report_contradicted", "report_not_checkable", "validated_outcomes", "receipt_failures", "evidence_files_supplied", "evidence_files_cited", "provenance_groups", "source_independence"],
      "properties": {
        "document_claims_total": { "type": "integer", "minimum": 0 },
        "document_claims_reached": { "type": "integer", "minimum": 0 },
        "claim_outcomes_proposed": { "type": "integer", "minimum": 0 },
        "material_claims_reviewed": { "type": "integer", "minimum": 0 },
        "supporting_claims_reviewed": { "type": "integer", "minimum": 0 },
        "confirmed": { "type": "integer", "minimum": 0 },
        "contradicted": { "type": "integer", "minimum": 0 },
        "not_checkable": { "type": "integer", "minimum": 0 },
        "evidence_confirmed": { "type": "integer", "minimum": 0 },
        "evidence_contradicted": { "type": "integer", "minimum": 0 },
        "evidence_not_checkable": { "type": "integer", "minimum": 0 },
        "report_confirmed": { "type": "integer", "minimum": 0 },
        "report_contradicted": { "type": "integer", "minimum": 0 },
        "report_not_checkable": { "type": "integer", "minimum": 0 },
        "validated_outcomes": { "type": "integer", "minimum": 0 },
        "receipt_failures": { "type": "integer", "minimum": 0 },
        "evidence_files_supplied": { "type": "integer", "minimum": 0 },
        "evidence_files_cited": { "type": "array", "items": { "type": "string" } },
        "provenance_groups": { "type": "array", "items": { "type": "object" } },
        "source_independence": { "type": "string", "enum": ["not_assessed", "grouped_by_declared_provenance"] }
      }
    },
    "decision": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["outcome", "text", "report_quote", "explanation", "supporting_check_ids", "key_points", "recommended_action_ids", "key_limit_ids"],
      "properties": {
        "outcome": { "type": "string", "enum": ["supported", "mixed", "not_supported", "not_checkable"] },
        "text": { "type": "string" },
        "report_quote": { "type": "string" },
        "explanation": { "type": "string" },
        "supporting_check_ids": { "type": "array", "items": { "type": "string" } },
        "key_points": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check_id", "text"],
            "properties": {
              "check_id": { "type": "string" },
              "text": { "type": "string" }
            }
          }
        },
        "recommended_action_ids": { "type": "array", "items": { "type": "string" } },
        "key_limit_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "report_quote"],
        "properties": {
          "id": { "type": "string", "pattern": "^A[0-9]+$" },
          "text": { "type": "string" },
          "report_quote": { "type": "string" }
        }
      }
    },
    "decision_limits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "report_quote"],
        "properties": {
          "id": { "type": "string", "pattern": "^L[0-9]+$" },
          "text": { "type": "string" },
          "report_quote": { "type": "string" }
        }
      }
    },
    "diagnostics": {
      "description": "Scanner and coverage details. These are not customer-facing report problems.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "statement"],
        "properties": {
          "check_id": { "type": "string" },
          "statement": { "type": "string" },
          "location": { "type": ["string", "null"] },
          "severity": { "type": ["string", "null"] }
        }
      }
    },
    "checks": {
      "type": "object",
      "required": ["registered", "with_findings", "found_nothing", "errored", "skipped_note"],
      "properties": {
        "registered": { "type": "integer" },
        "with_findings": { "type": "integer" },
        "found_nothing": { "type": "integer" },
        "errored": { "type": "integer" },
        "skipped_note": { "type": "string" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "semantic", "live_source"],
      "properties": {
        "document": { "$ref": "#/$defs/verificationStage" },
        "semantic": { "$ref": "#/$defs/verificationStage" },
        "live_source": { "$ref": "#/$defs/verificationStage" }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "offer": {
      "type": "object",
      "required": ["text", "accepted"],
      "properties": {
        "text": { "type": "string" },
        "accepted": { "type": ["boolean", "null"] }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "quote", "importance"],
        "properties": {
          "id": { "type": "string" },
          "quote": { "type": "string" },
          "importance": { "type": "string", "enum": ["material", "supporting"] },
          "classification": {
            "type": "string",
            "enum": ["material_claim", "supporting_provenance"]
          },
          "reason": { "type": ["string", "null"] },
          "outcome": { "type": ["string", "null"] },
          "check_id": { "type": ["string", "null"] },
          "found_by": { "type": ["string", "null"] },
          "verification_mode": {
            "type": ["string", "null"],
            "enum": ["internal_arithmetic", "external_evidence", "not_externally_verified", null]
          },
          "location": { "type": ["string", "null"] },
          "inventory_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/retainedSource" }
    },
    "presentation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string" },
        "check_ids": { "type": "array", "items": { "type": "string" } },
        "actions": { "type": "array" },
        "limits": { "type": "array" }
      }
    }
  },
  "$defs": {
    "publicOperand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value", "location"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "value": { "not": { "type": ["null", "boolean"] } },
        "location": { "type": "string", "minLength": 1 }
      }
    },
    "publicReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_operand", "decisive_operands", "explanation"],
      "properties": {
        "report_operand": { "$ref": "#/$defs/publicOperand" },
        "decisive_operands": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/publicOperand" }
        },
        "explanation": { "type": "string", "minLength": 1 },
        "calculation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expression", "result"],
          "properties": {
            "expression": { "type": "string", "minLength": 1 },
            "result": { "not": { "type": ["null", "boolean"] } }
          }
        },
        "source_id": { "type": "string", "minLength": 1 }
      }
    },
    "retainedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "evidence_file", "result_sha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$" },
        "kind": { "type": "string", "enum": ["supplied_file", "live_tool"] },
        "label": { "type": "string", "minLength": 1 },
        "evidence_file": { "type": "string", "minLength": 1 },
        "result_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "retrieval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["retrieved_at", "tool", "arguments"],
          "properties": {
            "retrieved_at": { "type": "string", "format": "date-time" },
            "tool": { "type": "string", "minLength": 1 },
            "arguments": { "type": "object" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "live_tool" } } },
          "then": { "required": ["retrieval"] }
        },
        {
          "if": { "properties": { "kind": { "const": "supplied_file" } } },
          "then": { "not": { "required": ["retrieval"] } }
        }
      ]
    },
    "verificationStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "detail"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["complete", "partial", "failed", "not_available", "not_requested", "not_run", "skipped"]
        },
        "detail": { "type": ["string", "null"] }
      }
    }
  }
}
