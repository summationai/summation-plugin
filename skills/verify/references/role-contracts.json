{
  "contract_version": "verify-role-handoff/coordinator-v5",
  "classifications": [
    "material_claim",
    "supporting_provenance",
    "structural_context"
  ],
  "independent_semantic_authorship": {
    "initial_prompt_allowed": [
      "report",
      "neutral_inventory",
      "approved_sources",
      "role_contracts"
    ],
    "initial_prompt_forbidden": [
      "claim_classifications",
      "verdicts",
      "severities",
      "check_ids",
      "public_labels",
      "operands",
      "calculations",
      "expected_counts",
      "score",
      "next_action",
      "prior_grade_artifact",
      "numeric_precision_choice",
      "source_side_winner"
    ],
    "repair_prompt_allowed": [
      "original_role_input",
      "prior_role_output",
      "mechanical_repair_reasons"
    ],
    "repair_prompt_forbidden": [
      "claim_classifications",
      "verdicts",
      "severities",
      "check_ids",
      "public_labels",
      "operands",
      "calculations",
      "expected_counts",
      "score",
      "next_action",
      "prior_grade_artifact",
      "numeric_precision_choice",
      "source_side_winner"
    ]
  },
  "claim_taker": {
    "input": {
      "required": ["partition_id", "visible_text", "inventory", "report_metadata"],
      "inventory_item_required": ["id", "displayed", "location", "importance"]
    },
    "output": {
      "required": ["partition_id", "candidates"],
      "candidate_required": [
        "id",
        "quote",
        "importance",
        "classification",
        "inventory_ids"
      ],
      "material_claim_required": ["clauses"],
      "material_clause_required": ["id", "quote", "public_label"],
      "supporting_provenance_required": ["public_label", "reason"],
      "structural_context_required": ["reason"]
    }
  },
  "coordinator": {
    "input": {
      "required": [
        "partition_results",
        "inventory",
        "report_metadata",
        "internal_candidates",
        "approved_sources"
      ],
      "candidate_required": [
        "id",
        "quote",
        "importance",
        "classification",
        "inventory_ids"
      ]
    },
    "output": {
      "required": [
        "canonical_claims",
        "membership",
        "structural_context",
        "verifier_assignments"
      ],
      "claim_required": [
        "id",
        "quote",
        "public_label",
        "importance",
        "classification",
        "inventory_ids",
        "member_refs"
      ],
      "membership_required": ["partition_id", "candidate_id", "canonical_claim_id"],
      "material_membership_required": ["clause_id"],
      "material_member_ref_required": ["partition_id", "candidate_id", "clause_id"],
      "structural_context_required": [
        "id",
        "partition_id",
        "candidate_id",
        "quote",
        "importance",
        "classification",
        "reason",
        "inventory_ids"
      ],
      "supporting_provenance_required": ["reason"],
      "verifier_assignment_required": ["verifier_id", "claim_ids"]
    },
    "preflight": {
      "runs_before": "acceptance",
      "repair_passes": 1,
      "returns": ["status", "repair_reasons", "coordinator"],
      "validates": [
        "complete_unique_opaque_membership",
        "complete_unique_material_clause_membership",
        "receipt_addresses_every_canonical_clause",
        "substantive_supporting_provenance_reason",
        "substantive_structural_context_reason",
        "public_numeric_calculation_result",
        "repeated_occurrence_correction_statement",
        "exact_population_alignment_receipts",
        "host_declared_numeric_comparison",
        "complete_approved_source_consideration",
        "duplicate_source_identity_rejection",
        "grounded_verdict_summary",
        "visible_confirmed_selection",
        "action_check_consistency"
      ]
    },
    "final_merge": {
      "input": {
        "required": ["canonical_claims", "evidence_verifier_results"]
      },
      "output": {
        "required": ["sources", "checks", "source_consideration", "presentation"],
        "source_consideration_required": [
          "source_id",
          "exactly_one_of_claim_ids_or_exclusion_reason"
        ],
        "source_consideration_coverage": "every deduplicated approved source is cited by its exact mapped canonical claims or carries a substantive exclusion reason",
        "presentation_required": ["summary", "check_ids", "actions", "limits"],
        "check_ids_meaning": "summary_grounding_ids; confirmed ids in this list are host-selected visible confirmations",
        "summary_grounding": "all ids are accepted checks and at least one is a decision-relevant confirmation when confirmed outcomes exist",
        "action_required": ["id", "kind", "text", "report_quote", "check_ids"],
        "action_kinds": [
          "correct_report",
          "reconcile_before_change",
          "review_before_share"
        ],
        "repeated_correction_action": "copies the exact accepted correction_notice.statement"
      }
    }
  },
  "evidence_verifier": {
    "input": {
      "required": ["partition_id", "visible_text", "claims", "sources"],
      "claims_from": "coordinator.output.canonical_claims",
      "claim_required": [
        "id",
        "quote",
        "public_label",
        "importance",
        "classification",
        "inventory_ids",
        "member_refs"
      ],
      "supporting_provenance_required": ["reason"]
    },
    "output": {
      "required": ["partition_id", "sources", "checks"],
      "check_required": [
        "id",
        "claim_id",
        "type",
        "basis",
        "verdict",
        "importance",
        "severity",
        "addressed_clause_refs",
        "public_receipt"
      ],
      "addressed_clause_ref_required": [
        "partition_id",
        "candidate_id",
        "clause_id"
      ],
      "repeated_occurrence_correction_notice": {
        "required": [
          "statement",
          "report_value",
          "replacement_value",
          "locations"
        ],
        "statement_usage": [
          "public_receipt.explanation",
          "coordinator.final_merge.presentation.actions"
        ]
      },
      "public_receipt_required": [
        "report_operand",
        "decisive_operands",
        "explanation"
      ],
      "calculation": {
        "required": ["expression", "result"],
        "result": "public_numeric_value"
      },
      "numeric_comparison": {
        "required_for": "confirmed or contradicted report-basis arithmetic with numeric report and calculated values",
        "modes": ["rounded", "absolute_tolerance"],
        "rounded_required": ["mode", "rounding", "decimal_places"],
        "rounding_values": ["half_up", "half_even"],
        "absolute_tolerance_required": ["mode", "tolerance"],
        "private_from_public_output": true,
        "host_selects_mode_and_precision": true
      },
      "population_alignment": {
        "required_for": "dated evidence-basis confirmed or contradicted outcome",
        "statuses": ["same_population", "unreconciled"],
        "same_population_required": ["status", "reason", "links"],
        "link_required": ["dimension", "report_quote", "source_receipt"],
        "link_dimensions": [
          "report_period",
          "as_of_date",
          "scope",
          "population_key"
        ],
        "unreconciled_required": [
          "status",
          "reason",
          "missing_dimensions",
          "conflict_receipts",
          "reconciliation_action"
        ],
        "unreconciled_verdict": "not_checkable",
        "unreconciled_action_kind": "reconcile_before_change"
      }
    }
  },
  "mechanical_outputs": {
    "verification.live_source": {
      "input": "accepted sources[].kind",
      "live_tool_present": {"status": "complete", "detail": null},
      "otherwise": {"status": "not_run", "detail": null},
      "host_authored": false
    }
  },
  "routes": {
    "native_subagents": {
      "primary": true,
      "stages": ["claim_taker", "coordinator", "evidence_verifier"],
      "input_contracts": [
        "claim_taker.input",
        "coordinator.input",
        "evidence_verifier.input"
      ],
      "output_contracts": [
        "claim_taker.output",
        "coordinator.output",
        "evidence_verifier.output"
      ]
    },
    "sequential": {
      "primary": false,
      "stages": ["claim_taker", "coordinator", "evidence_verifier"],
      "input_contracts": [
        "claim_taker.input",
        "coordinator.input",
        "evidence_verifier.input"
      ],
      "output_contracts": [
        "claim_taker.output",
        "coordinator.output",
        "evidence_verifier.output"
      ]
    }
  }
}
